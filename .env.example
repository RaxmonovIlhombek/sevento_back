# Nusxa oling: cp .env.example .env  (hech qachon .env ni commit qilmang)

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Brauzer manzillari (Origin tekshiruvi va CSRF uchun), vergul bilan
DJANGO_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Ma'lumotlar bazasi va Redis ---
# docker-compose ichida: postgres://sevento:sevento@postgres:5432/sevento
DATABASE_URL=postgres://sevento:sevento@127.0.0.1:5432/sevento
# docker-compose ichida: redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE_NAME=sevento_refresh
# prod da True bo'lishi shart (faqat HTTPS). Lokal http uchun False
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Strict

# --- WebSocket ---
REALTIME_TICKET_TTL=30
REALTIME_MAX_CONNECTIONS_PER_USER=10
# Brauzer Origin ro'yxati; bo'sh qoldirilsa DJANGO_TRUSTED_ORIGINS + Tauri
# REALTIME_ALLOWED_ORIGINS=https://sevento.example

# --- Throttle ---
THROTTLE_LOGIN=10/min

# --- Boshlang'ich foydalanuvchi (faqat MB da hech qanday foydalanuvchi bo'lmasa yaratiladi) ---
# Lokal sinov uchun namuna — haqiqiy o'rnatishda albatta o'zgartiring
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ADMIN_FULL_NAME=Rahbar

# --- Demo ma'lumotlar (ixtiyoriy): konteyner ishga tushganda `seed_demo` ---
# SEED_DEMO=1
# Demo foydalanuvchilar paroli; bo'sh bo'lsa tasodifiy parol log ga chiqadi
# DEMO_PASSWORD=

# --- Postgres konteyneri uchun ---
POSTGRES_DB=sevento
POSTGRES_USER=sevento
POSTGRES_PASSWORD=sevento

# --- Frontend konteynerini qurish uchun (compose) ---
FRONTEND_DIR=../sevento_front
FRONTEND_PORT=3000
BACKEND_PORT=8000
